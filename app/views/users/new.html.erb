<h1>ユーザ登録</h1>
<% @user.errors.full_messages.each do |msg| %>
  <p style="color: red;"><%= msg %></p>
<% end %>
<%= form_with model: @user do |f| %>
  ユーザID：<%= f.text_field :uid %><br>
  パスワード：<%= f.text_field :password %><br>
  パスワード（確認）：<%= f.text_field :password_confirmation %><br>
  <%= f.submit "登録" %>
<% end %>