<h1>つぶやきアプリ</h1>
<p style="color: red;"><%= flash[:alert] %></p>

<% if session[:login_uid] %>
    <p>
    <%= session[:login_uid] %> でログイン中　
    <%= link_to "プロフィール編集", edit_profile_path %>　
    <%= link_to "ログアウト", top_logout_path %>
    </p>
  <%= form_with model: @tweet do |f| %>
    <%= f.text_field :message %>
    <%= f.submit "ツイート" %>
  <% end %>
<% else %>
  <%= form_with url: top_login_path do |f| %>
    ユーザID：<%= f.text_field :uid %>
    パスワード：<%= f.password_field :pass %>
    <%= f.submit "ログイン" %>
  <% end %>
  <%= link_to "新規登録", new_user_path %>
<% end %>

<table>
  <% @tweets.each do |e| %>
    <tr>
      <td><%= link_to e.user.uid, user_path(e.user) %></td>
      <td><%= e.message %></td>
      <td>♥<%= e.likes.count %></td>
      <td>
        <% if @login_user %>
          <% if @login_user.like_tweets.include?(e) %>
            <%= link_to "いいね削除", like_path(e), data: { turbo_method: :delete } %>
          <% else %>
            <%= link_to "いいね", likes_path(tweet_id: e.id), data: { turbo_method: :post } %>
          <% end %>
        <% end %>
      </td>
      <td>
        <% if session[:login_uid] == e.user.uid %>
          <%= link_to "削除", tweet_path(e), data: { turbo_method: :delete } %>
        <% end %>
      </td>
    </tr>
  <% end %>
</table>
